# Algorythm5 configuration. Copy to .env and adjust. No secrets are needed.

# Where the SQLite database, uploads and outputs are stored (git-ignored).
DATA_DIR=data

# Upload and parsing limits.
MAX_UPLOAD_MB=10
MAX_ROWS=50000
MAX_COLUMNS=100
MAX_CELL_CHARS=1000
MAX_XLSX_UNCOMPRESSED_MB=100

# Cleaning defaults (open decisions D1-D5 in CLAUDE.md).
DEFAULT_PHONE_REGION=AL
# include | review | exclude
UNKNOWN_CONSENT_POLICY=include
# email | any
REQUIRED_CHANNEL=email
# DMY | MDY
DATE_ORDER=DMY

# Output CSV delimiter: , or ;
CSV_DELIMITER=,

# Days before jobs and their files are deleted automatically.
RETENTION_DAYS=7
